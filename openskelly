#!/usr/bin/env python3
"""Control 12ft Skelly lighting, eyes, Live audio, and system audio output."""

from __future__ import annotations

import argparse
import json
import os
import pty
import re
import select
import signal
import subprocess
import sys
import tempfile
import time
from pathlib import Path

GATT_HANDLE = "0x0082"

COMMANDS = {
    "stop_file": "aac60000000000000000ed",
    "enable_live_radio": "aafd0100000000000000d1",
    "select_bluetooth": "aafe010000000000000024",
    "start_live": "aafc010000000000000075",
    "stop_live": "aafc000000000000000036",
    "volume_100": "aafa640000000000000031",
}

ROOT = Path(__file__).resolve().parent
RUNTIME = ROOT / ".skelly-live"
PID_FILE = RUNTIME / "pid"
MODE_FILE = RUNTIME / "mode"
LOG_FILE = RUNTIME / "skelly-live.log"
CONFIG_FILE = Path.home() / ".config" / "openskelly" / "config.json"


def load_config() -> dict[str, str | float]:
    try:
        config = json.loads(CONFIG_FILE.read_text())
    except FileNotFoundError as exc:
        raise RuntimeError("not configured; run: openskelly configure") from exc
    required = ("ble_mac", "live_mac", "mic_source")
    missing = [key for key in required if not config.get(key)]
    if missing:
        raise RuntimeError(f"missing configuration values: {', '.join(missing)}")
    config.setdefault("gain", 2.0)
    return config


def sink_name(live_mac: str) -> str:
    return f"bluez_output.{live_mac.replace(':', '_')}.1"


def pid_is_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
        return True
    except (ProcessLookupError, PermissionError):
        return False


def current_pid() -> int | None:
    try:
        pid = int(PID_FILE.read_text().strip())
    except (FileNotFoundError, ValueError):
        return None
    return pid if pid_is_alive(pid) else None


class GattSession:
    def __init__(self, ble_mac: str) -> None:
        self.master, slave = pty.openpty()
        self.proc = subprocess.Popen(
            ["gatttool", "-b", ble_mac, "-I"],
            stdin=slave,
            stdout=slave,
            stderr=slave,
            close_fds=True,
        )
        os.close(slave)
        self.buffer = ""
        self.closed = False

    def send(self, line: str) -> None:
        os.write(self.master, (line + "\n").encode())

    def wait_for(self, text: str, timeout: float) -> None:
        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline:
            readable, _, _ = select.select([self.master], [], [], 0.25)
            if not readable:
                continue
            try:
                chunk = os.read(self.master, 4096).decode(errors="replace")
            except OSError as exc:
                raise RuntimeError("BLE control connection closed") from exc
            self.buffer = (self.buffer + chunk)[-16384:]
            if text in self.buffer:
                return
            if "Error:" in chunk or "Command Failed" in chunk:
                raise RuntimeError(chunk.strip())
        raise RuntimeError(f"timed out waiting for BLE response: {text}")

    def connect(self) -> None:
        self.send("connect")
        self.wait_for("Connection successful", 20)

    def write(self, value: str, acknowledgement: str | None = None) -> None:
        self.buffer = ""
        self.send(f"char-write-cmd {GATT_HANDLE} {value}")
        if acknowledgement:
            self.wait_for(acknowledgement, 5)
        else:
            time.sleep(0.12)

    def close(self) -> None:
        if self.closed:
            return
        self.closed = True
        if self.proc.poll() is None:
            try:
                self.send("exit")
                self.proc.wait(timeout=2)
            except Exception:
                self.proc.terminate()
                try:
                    self.proc.wait(timeout=2)
                except subprocess.TimeoutExpired:
                    self.proc.kill()
        try:
            os.close(self.master)
        except OSError:
            pass


def run_checked(*args: str, timeout: float = 20) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        args,
        check=True,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        timeout=timeout,
    )


def connect_gatt(ble_mac: str) -> GattSession:
    last_error: Exception | None = None
    for _ in range(3):
        session: GattSession | None = None
        try:
            subprocess.run(
                ["bluetoothctl", "--timeout", "3", "scan", "le"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=5,
            )
            session = GattSession(ble_mac)
            session.connect()
            return session
        except Exception as exc:
            last_error = exc
            if session:
                session.close()
            time.sleep(1)
    raise RuntimeError(f"could not connect to Skelly BLE control: {last_error}")


def crc8(data: bytes) -> int:
    """DecorPro's reflected CRC-8 (polynomial 0x8C)."""
    crc = 0
    for byte in data:
        crc ^= byte
        for _ in range(8):
            crc = (crc >> 1) ^ 0x8C if crc & 1 else crc >> 1
    return crc


def light_channel(value: str) -> int:
    aliases = {"chest": 0, "all": 0xFF}
    if value.lower() in aliases:
        return aliases[value.lower()]
    try:
        channel = int(value)
    except ValueError as exc:
        raise argparse.ArgumentTypeError("channel must be chest, all, or 0-5") from exc
    if not 0 <= channel <= 5:
        raise argparse.ArgumentTypeError("channel must be chest, all, or 0-5")
    return channel


def protocol_frame(opcode: int, payload: bytes) -> str:
    frame = bytes((0xAA, opcode)) + payload
    return (frame + bytes((crc8(frame),))).hex()


def set_light(channel: int, rgb: str | None, brightness: int | None) -> int:
    if current_pid():
        print("Stop microphone Live mode before changing lights.", file=sys.stderr)
        return 1
    gatt: GattSession | None = None
    try:
        ble_mac = str(load_config()["ble_mac"])
        gatt = connect_gatt(ble_mac)
        if rgb is not None:
            color = bytes.fromhex(rgb)
            gatt.write(protocol_frame(0xF4, bytes((channel,)) + color + b"\x00\xff\xff\xff\xff\x00"))
        if brightness is not None:
            gatt.write(protocol_frame(0xF3, bytes((channel, brightness)) + b"\xff\xff\xff\xff\x00\x00"))
        return 0
    except Exception as exc:
        print(f"OpenSkelly light control failed: {exc}", file=sys.stderr)
        return 1
    finally:
        if gatt:
            gatt.close()


def set_eyes(pattern: int) -> int:
    if current_pid():
        print("Stop microphone Live mode before changing eyes.", file=sys.stderr)
        return 1
    gatt: GattSession | None = None
    try:
        ble_mac = str(load_config()["ble_mac"])
        gatt = connect_gatt(ble_mac)
        gatt.write(protocol_frame(0xF9, bytes((pattern, 0)) + b"\xff\xff\xff\xff\x00"))
        return 0
    except Exception as exc:
        print(f"OpenSkelly eye control failed: {exc}", file=sys.stderr)
        return 1
    finally:
        if gatt:
            gatt.close()


def set_loopback_gain(gain: float) -> None:
    status = ""
    for _ in range(20):
        status = run_checked("wpctl", "status").stdout
        match = re.search(r"(\d+)\.\s+output\.skelly-live-mic\b", status)
        if match:
            run_checked("wpctl", "set-volume", "-l", str(max(4.0, gain)), match.group(1), str(gain))
            return
        time.sleep(0.25)
    names = "\n".join(line for line in status.splitlines() if "skelly" in line.lower())
    raise RuntimeError(f"microphone bridge appeared, but its gain control was not found:\n{names}")


def bluetooth_connected(mac: str) -> bool:
    try:
        output = run_checked("bluetoothctl", "info", mac, timeout=5).stdout
    except Exception:
        return False
    return bool(re.search(r"^\s*Connected:\s+yes\s*$", output, re.MULTILINE))


def restore_default_sink(previous: str | None) -> None:
    if previous:
        try:
            run_checked("pactl", "set-default-sink", previous)
        except Exception:
            pass


def spotify_sink_input_ids(output: str) -> list[str]:
    ids = []
    for block in re.split(r"(?=Sink Input #)", output):
        number = re.search(r"^Sink Input #(\d+)", block)
        if number and 'application.process.binary = "spotifyd"' in block:
            ids.append(number.group(1))
    return ids


def route_spotify_direct(live_mac: str) -> None:
    target = sink_name(live_mac)
    for _ in range(30):
        sinks = run_checked("pactl", "list", "sinks", "short").stdout
        if target in sinks:
            break
        time.sleep(0.2)
    else:
        raise RuntimeError("Skelly connected, but its audio sink did not appear")
    run_checked("pactl", "set-default-sink", target)
    inputs = run_checked("pactl", "list", "sink-inputs").stdout
    for input_id in spotify_sink_input_ids(inputs):
        run_checked("pactl", "move-sink-input", input_id, target)


def stop_process(proc: subprocess.Popen[bytes] | None) -> None:
    if not proc or proc.poll() is not None:
        return
    proc.terminate()
    try:
        proc.wait(timeout=3)
    except subprocess.TimeoutExpired:
        proc.kill()


def start_microphone_bridge(live_mac: str, mic_source: str, gain: float) -> subprocess.Popen[bytes]:
    proc = subprocess.Popen(
        [
            "pw-loopback", "--name", "skelly-live-mic", "--channels", "2",
            "--channel-map", "[ FL, FR ]", "--latency", "100",
            "--capture", mic_source, "--playback", sink_name(live_mac),
            "--capture-props", "{ audio.rate = 44100 audio.format = S16LE }",
            "--playback-props", "{ audio.rate = 44100 audio.format = S16LE }",
        ]
    )
    time.sleep(0.5)
    if proc.poll() is not None:
        raise RuntimeError("Skelly microphone bridge failed to start")
    try:
        set_loopback_gain(gain)
    except Exception:
        stop_process(proc)
        raise
    return proc


def connect_live(gatt: GattSession, live_mac: str) -> None:
    gatt.write(COMMANDS["stop_file"])
    gatt.write(COMMANDS["stop_live"])
    gatt.write(COMMANDS["enable_live_radio"], "bb fd 01")
    last_output = ""
    for _ in range(4):
        result = subprocess.run(
            ["bluetoothctl", "connect", live_mac], text=True,
            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=15,
        )
        last_output = result.stdout.strip()
        if bluetooth_connected(live_mac):
            break
        time.sleep(1)
        gatt.write(COMMANDS["enable_live_radio"])
    else:
        raise RuntimeError(f"could not connect Skelly audio: {last_output}")
    gatt.write(COMMANDS["select_bluetooth"], "bb fe 01")


def activate_mode(
    gatt: GattSession,
    mode: str,
    live_mac: str,
    mic_source: str,
    gain: float,
) -> subprocess.Popen[bytes] | None:
    connect_live(gatt, live_mac)
    bridge = None
    if mode == "output":
        route_spotify_direct(live_mac)
    else:
        bridge = start_microphone_bridge(live_mac, mic_source, gain)
    try:
        gatt.write(COMMANDS["start_live"])
        time.sleep(0.08)
        gatt.write(COMMANDS["volume_100"])
    except Exception:
        stop_process(bridge)
        raise
    return bridge


def daemon(mode: str = "mic") -> int:
    RUNTIME.mkdir(exist_ok=True)
    PID_FILE.write_text(f"{os.getpid()}\n")
    MODE_FILE.write_text(f"{mode}\n")
    stop_requested = False

    def request_stop(_signum: int, _frame: object) -> None:
        nonlocal stop_requested
        stop_requested = True

    signal.signal(signal.SIGTERM, request_stop)
    signal.signal(signal.SIGINT, request_stop)
    gatt: GattSession | None = None
    audio_bridge: subprocess.Popen[bytes] | None = None
    previous_sink: str | None = None
    try:
        config = load_config()
        ble_mac = str(config["ble_mac"])
        live_mac = str(config["live_mac"])
        mic_source = str(config["mic_source"])
        gain = float(config["gain"])
        if mode == "output":
            previous_sink = run_checked("pactl", "get-default-sink").stdout.strip()
        gatt = connect_gatt(ble_mac)
        audio_bridge = activate_mode(gatt, mode, live_mac, mic_source, gain)
        print(f"Skelly {mode} mode is running", flush=True)

        while not stop_requested:
            bridge_failed = audio_bridge is not None and audio_bridge.poll() is not None
            if bridge_failed or not bluetooth_connected(live_mac):
                print("Skelly audio disconnected; reconnecting…", flush=True)
                stop_process(audio_bridge)
                audio_bridge = None
                reconnected = False
                for attempt in range(1, 6):
                    try:
                        try:
                            gatt.close()
                        except Exception:
                            pass
                        gatt = connect_gatt(ble_mac)
                        audio_bridge = activate_mode(gatt, mode, live_mac, mic_source, gain)
                        print("Skelly audio reconnected", flush=True)
                        reconnected = True
                        break
                    except Exception as exc:
                        print(f"Reconnect attempt {attempt} failed: {exc}", flush=True)
                        time.sleep(min(attempt * 2, 8))
                if not reconnected:
                    raise RuntimeError("could not restore Skelly audio after five attempts")
            time.sleep(2)
        return 0
    except Exception as exc:
        print(f"Skelly Live failed: {exc}", file=sys.stderr, flush=True)
        return 1
    finally:
        if gatt:
            try:
                gatt.write(COMMANDS["stop_live"])
            except Exception:
                pass
        stop_process(audio_bridge)
        restore_default_sink(previous_sink)
        try:
            if "live_mac" in locals():
                run_checked("bluetoothctl", "disconnect", live_mac, timeout=10)
        except Exception:
            pass
        if gatt:
            gatt.close()
        PID_FILE.unlink(missing_ok=True)
        MODE_FILE.unlink(missing_ok=True)


def start(mode: str = "mic") -> int:
    if pid := current_pid():
        print(f"Skelly Live is already running (PID {pid})")
        return 0
    RUNTIME.mkdir(exist_ok=True)
    with LOG_FILE.open("wb", buffering=0) as log:
        proc = subprocess.Popen(
            [sys.executable, str(Path(__file__).resolve()), "_run", mode],
            stdin=subprocess.DEVNULL,
            stdout=log,
            stderr=log,
            start_new_session=True,
        )
    for _ in range(60):
        time.sleep(0.25)
        if current_pid() == proc.pid:
            text = LOG_FILE.read_text(errors="replace")
            if f"Skelly {mode} mode is running" in text:
                print(f"Skelly {mode} mode started (PID {proc.pid})")
                return 0
        if proc.poll() is not None:
            print(LOG_FILE.read_text(errors="replace").rstrip(), file=sys.stderr)
            return proc.returncode or 1
    print(f"Skelly Live is still starting; see {LOG_FILE}", file=sys.stderr)
    return 1


def stop() -> int:
    pid = current_pid()
    if not pid:
        PID_FILE.unlink(missing_ok=True)
        print("Skelly Live is not running")
        return 0
    os.kill(pid, signal.SIGTERM)
    for _ in range(40):
        if not pid_is_alive(pid):
            print("Skelly Live stopped")
            return 0
        time.sleep(0.25)
    print(f"Skelly Live did not stop cleanly (PID {pid})", file=sys.stderr)
    return 1


def status() -> int:
    if pid := current_pid():
        mode = MODE_FILE.read_text().strip() if MODE_FILE.exists() else "mic"
        connected = bluetooth_connected(str(load_config()["live_mac"]))
        state = "connected" if connected else "reconnecting"
        print(f"Skelly {mode} mode is running (PID {pid}, {state})")
        return 0 if connected else 1
    print("Skelly Live is stopped")
    return 1


def prepare_audio(source: Path, output: Path) -> None:
    if not source.is_file():
        raise RuntimeError(f"audio file not found: {source}")
    run_checked(
        "ffmpeg", "-hide_banner", "-loglevel", "error", "-y",
        "-i", str(source), "-af",
        "loudnorm=I=-10:TP=-1:LRA=11,adelay=2000|2000,apad=pad_dur=0.75",
        "-ar", "44100", "-ac", "2", str(output), timeout=60,
    )


def play_audio(source: Path) -> int:
    if current_pid():
        print("Stop Live mode before using 'play'.", file=sys.stderr)
        return 1
    gatt: GattSession | None = None
    try:
        config = load_config()
        ble_mac = str(config["ble_mac"])
        live_mac = str(config["live_mac"])
        with tempfile.TemporaryDirectory(prefix="openskelly-") as temp:
            speech = Path(temp) / "prepared.wav"
            print("Preparing audio…", flush=True)
            prepare_audio(source, speech)
            gatt = connect_gatt(ble_mac)
            gatt.write(COMMANDS["stop_file"])
            gatt.write(COMMANDS["enable_live_radio"], "bb fd 01")
            result = run_checked("bluetoothctl", "connect", live_mac)
            if "Connection successful" not in result.stdout and "already connected" not in result.stdout.lower():
                raise RuntimeError(result.stdout.strip())
            gatt.write(COMMANDS["select_bluetooth"], "bb fe 01")
            player = subprocess.Popen([
                "pw-play", "--target", sink_name(live_mac), "--volume", "1.0", str(speech)
            ])
            time.sleep(0.3)
            gatt.write(COMMANDS["start_live"])
            time.sleep(0.08)
            gatt.write(COMMANDS["volume_100"])
            if player.wait(timeout=120) != 0:
                raise RuntimeError("speech playback failed")
        return 0
    except Exception as exc:
        print(f"OpenSkelly playback failed: {exc}", file=sys.stderr)
        return 1
    finally:
        if gatt:
            try:
                gatt.write(COMMANDS["stop_live"])
            except Exception:
                pass
        try:
            if "live_mac" in locals():
                run_checked("bluetoothctl", "disconnect", live_mac, timeout=10)
        except Exception:
            pass
        if gatt:
            gatt.close()


def bluetooth_devices() -> list[tuple[str, str]]:
    output = run_checked("bluetoothctl", "devices").stdout
    devices = []
    for line in output.splitlines():
        match = re.match(r"Device ([0-9A-F:]{17}) (.+)", line, re.IGNORECASE)
        if match:
            devices.append((match.group(1).upper(), match.group(2)))
    return devices


def default_microphone() -> str:
    output = run_checked("wpctl", "status").stdout
    sources = output.split("├─ Sources:", 1)[-1].split("├─ Filters:", 1)[0]
    match = re.search(r"^\s*\*\s*(\d+)\..*$", sources, re.MULTILINE)
    if not match:
        raise RuntimeError("could not find the default PipeWire microphone")
    inspected = run_checked("wpctl", "inspect", match.group(1)).stdout
    name = re.search(r'node\.name = "([^"]+)"', inspected)
    if not name:
        raise RuntimeError("could not determine the default microphone name")
    return name.group(1)


def configure(args: argparse.Namespace) -> int:
    devices = bluetooth_devices()
    ble_mac = args.ble_mac or next((m for m, n in devices if n == "12ft Skelly"), None)
    live_mac = args.live_mac or next((m for m, n in devices if n == "12ft Skelly(Live)"), None)
    if not ble_mac or not live_mac:
        print("Could not discover both endpoints; use --ble-mac and --live-mac.", file=sys.stderr)
        return 1
    config = {
        "ble_mac": ble_mac.upper(),
        "live_mac": live_mac.upper(),
        "mic_source": args.mic_source or default_microphone(),
        "gain": args.gain,
    }
    CONFIG_FILE.parent.mkdir(parents=True, exist_ok=True)
    CONFIG_FILE.write_text(json.dumps(config, indent=2) + "\n")
    print(f"Saved {CONFIG_FILE}")
    print(json.dumps(config, indent=2))
    return 0


def main() -> int:
    if len(sys.argv) > 1 and sys.argv[1] == "_run":
        return daemon(sys.argv[2] if len(sys.argv) > 2 else "mic")
    parser = argparse.ArgumentParser(description=__doc__)
    subs = parser.add_subparsers(dest="action")
    subs.add_parser("start")
    subs.add_parser("stop")
    subs.add_parser("status")
    output = subs.add_parser("output", help="route system audio with automatic reconnect")
    output.add_argument("output_action", choices=("start", "status", "stop"))
    play_parser = subs.add_parser("play", help="play an audio file with synchronized animation")
    play_parser.add_argument("audio", type=Path)
    setup = subs.add_parser("configure")
    setup.add_argument("--ble-mac")
    setup.add_argument("--live-mac")
    setup.add_argument("--mic-source")
    setup.add_argument("--gain", type=float, default=2.0)
    lights = subs.add_parser("lights", help="control Skelly's RGB chest light")
    light_subs = lights.add_subparsers(dest="lights_action", required=True)
    color = light_subs.add_parser("color", help="set an RGB color")
    color.add_argument("rgb", help="six-digit RGB hex value, such as ff0000")
    color.add_argument("--channel", type=light_channel, default=0)
    color.add_argument("--brightness", type=int, choices=range(101), default=100, metavar="0-100")
    brightness = light_subs.add_parser("brightness", help="set light brightness")
    brightness.add_argument("value", type=int, choices=range(101), metavar="0-100")
    brightness.add_argument("--channel", type=light_channel, default=0)
    off = light_subs.add_parser("off", help="turn a light off")
    off.add_argument("--channel", type=light_channel, default=0)
    eyes = subs.add_parser("eyes", help="select a built-in eye pattern")
    eye_subs = eyes.add_subparsers(dest="eyes_action", required=True)
    eye_set = eye_subs.add_parser("set", help="select pattern 1 through 20")
    eye_set.add_argument("pattern", type=int, choices=range(1, 21), metavar="1-20")
    args = parser.parse_args()
    action = args.action or "status"
    if action == "start":
        return start()
    if action == "stop":
        return stop()
    if action == "status":
        return status()
    if action == "configure":
        return configure(args)
    if action == "play":
        return play_audio(args.audio)
    if action == "output":
        if args.output_action == "start":
            return start("output")
        if args.output_action == "status":
            return status()
        return stop()
    if action == "lights":
        if args.lights_action == "color":
            if not re.fullmatch(r"[0-9a-fA-F]{6}", args.rgb):
                parser.error("RGB color must be exactly six hexadecimal digits")
            return set_light(args.channel, args.rgb, args.brightness)
        if args.lights_action == "brightness":
            return set_light(args.channel, None, args.value)
        if args.lights_action == "off":
            return set_light(args.channel, None, 0)
    if action == "eyes" and args.eyes_action == "set":
        return set_eyes(args.pattern)
    print(f"Usage: {Path(sys.argv[0]).name} start|status|stop", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
